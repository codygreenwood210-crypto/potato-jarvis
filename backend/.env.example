OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=120
POTATO_API_TOKEN=change-me
POTATO_ALLOW_ANONYMOUS=false
POTATO_ENV=development
POTATO_ALLOW_PRIVATE_DEVICE_NETWORKS=false
HOST=127.0.0.1
PORT=8000

# Production SSRF/DNS-rebinding hardening for configured device/Home Assistant hosts.
# Comma-separated exact hostnames; required for production hostnames (IP literals are allowed).
POTATO_DEVICE_HOST_ALLOWLIST=
